#!/bin/bash
# Gracefully signal active Wayland clients, layers, and daemons before exiting
# Hyprland.

# How many milliseconds to wait for processes to handle a SIGTERM.
TIMEOUT_MS=2500
# The period in seconds to check that all processes we're waiting on have
# exited.
INTERVAL=0.05

# Blank the display immediately for instant, seamless visual feedback
hyprctl dispatch dpms off 2>/dev/null

# Collect all active client and layer PIDs recursively from Hyprland IPC
mapfile -t IPC_PIDS < <(
    {
        hyprctl clients -j 2>/dev/null
        hyprctl layers -j 2>/dev/null
    } | jq -r '.. | .pid? // empty' | sort -u
)

# Combine and filter unique, valid, running PIDs (excluding self)
TARGET_PIDS=()
for pid in "${IPC_PIDS[@]}"; do
    if [ -n "$pid" ] && [ "$pid" -gt 0 ] && [ "$pid" -ne "$$" ] && kill -0 "$pid" 2>/dev/null; then
        TARGET_PIDS+=("$pid")
    fi
done

# Remove duplicates
mapfile -t TARGET_PIDS < <(printf '%s\n' "${TARGET_PIDS[@]}" | sort -u)

# Send SIGTERM to all target processes
if [ ${#TARGET_PIDS[@]} -gt 0 ]; then
    kill -TERM "${TARGET_PIDS[@]}" 2>/dev/null

    # Wait adaptively for processes to exit cleanly
    start_time=$(date +%s%N)
    timeout_ns=$(( TIMEOUT_MS * 1000000 ))

    while true; do
        still_running=0
        for pid in "${TARGET_PIDS[@]}"; do
            if kill -0 "$pid" 2>/dev/null; then
                still_running=1
                break
            fi
        done

        # Exit wait loop immediately if all targets have exited
        if [ "$still_running" -eq 0 ]; then
            break
        fi

        now=$(date +%s%N)
        elapsed=$(( now - start_time ))
        if [ "$elapsed" -ge "$timeout_ns" ]; then
            break
        fi

        sleep "$INTERVAL"
    done
fi

# Stop portal services cleanly so they don't segfault or rapid-restart on
# socket loss
systemctl --user stop xdg-desktop-portal-hyprland.service xdg-desktop-portal.service 2>/dev/null

# Terminate Hyprland session
hyprctl dispatch exit
