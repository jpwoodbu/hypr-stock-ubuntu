#!/usr/bin/env bash
# Gracefully signal active Wayland clients and daemons before ending the
# Hyprland session (logout, reboot, or shutdown).

set -euo pipefail

# How many milliseconds to wait for processes to handle a SIGTERM.
TIMEOUT_MS=2500
# The period in seconds to check that all processes we're waiting on have
# exited.
INTERVAL=0.05

usage() {
    echo "Usage: $(basename "$0") [logout|reboot|shutdown|poweroff]" >&2
    exit 1
}

# Require an action argument or default to logout if omitted.
ACTION="${1:-logout}"

case "$ACTION" in
    logout|reboot|shutdown|poweroff)
        ;;
    -h|--help)
        usage
        ;;
    *)
        echo "Error: Unknown action '$ACTION'." >&2
        usage
        ;;
esac

# Blank the display immediately on logout only. GDM will turn on the display
# when it takes over. For reboot and shutdown, leave the display on so that any
# progress systemd displays is still visible.
if [ "$ACTION" = "logout" ]; then
    hyprctl dispatch dpms off 2>/dev/null || true
fi

# Collect all active client PIDs recursively from Hyprland IPC.
# The hyprctl/jq stage is failure-tolerant so a dead compositor socket
# degrades to an empty PID list instead of aborting the session end.
mapfile -t IPC_PIDS < <(
    hyprctl clients -j 2>/dev/null | jq -r '.. | .pid? // empty' 2>/dev/null | sort -u || true
)

# Filter to valid, running PIDs (excluding self).
TARGET_PIDS=()
for pid in "${IPC_PIDS[@]}"; do
    if [ -n "$pid" ] && [ "$pid" -gt 0 ] && [ "$pid" -ne "$$" ] && kill -0 "$pid" 2>/dev/null; then
        TARGET_PIDS+=("$pid")
    fi
done

# Send SIGTERM to all target processes.
if [ ${#TARGET_PIDS[@]} -gt 0 ]; then
    kill -TERM "${TARGET_PIDS[@]}" 2>/dev/null

    # Wait adaptively for processes to exit cleanly.
    start_time=$(date +%s%N)
    timeout_ns=$(( TIMEOUT_MS * 1000000 ))

    while true; do
        still_running=0
        for pid in "${TARGET_PIDS[@]}"; do
            if kill -0 "$pid" 2>/dev/null; then
                still_running=1
                break
            fi
        done

        # Exit wait loop immediately if all targets have exited.
        if [ "$still_running" -eq 0 ]; then
            break
        fi

        now=$(date +%s%N)
        elapsed=$(( now - start_time ))
        if [ "$elapsed" -ge "$timeout_ns" ]; then
            break
        fi

        sleep "$INTERVAL"
    done
fi

# Execute the requested session termination action.
case "$ACTION" in
    logout)
        # Stop session targets so background user services shut down cleanly.
        # This is started in hyprland.conf and only needs explicit stopping on
        # logout; reboot and shutdown stop all user targets implicitly.
        systemctl --user stop hyprland-session.target graphical-session.target 2>/dev/null || true
        hyprctl dispatch exit
        ;;
    reboot)
        systemctl reboot
        ;;
    shutdown|poweroff)
        systemctl poweroff
        ;;
esac
