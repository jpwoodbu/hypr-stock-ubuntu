#!/usr/bin/env python3
"""Searchable keybindings menu & command palette for Hyprland using wofi.

Inspired by Omarchy's omarchy-menu-keybindings.
"""

import json
from pathlib import Path
import re
import subprocess
import sys
import time
from dataclasses import dataclass


KEY_MAP = {
    "mouse:272": "LMB (Drag)",
    "mouse:273": "RMB (Drag)",
    "mouse_up": "Scroll Up",
    "mouse_down": "Scroll Down",
    "Return": "Enter",
    "BackSpace": "Backspace",
    "SPACE": "Space",
    "left": "Left",
    "right": "Right",
    "up": "Up",
    "down": "Down",
    "XF86AudioRaiseVolume": "Volume Up",
    "XF86AudioLowerVolume": "Volume Down",
    "XF86AudioMute": "Mute",
    "XF86AudioMicMute": "Mic Mute",
    "XF86MonBrightnessUp": "Brightness Up",
    "XF86MonBrightnessDown": "Brightness Down",
    "XF86AudioNext": "Media Next",
    "XF86AudioPrev": "Media Prev",
    "XF86AudioPlay": "Media Play",
    "XF86AudioPause": "Media Pause",
    "page_up": "Page Up",
    "page_down": "Page Down",
}


@dataclass(frozen=True)
class Keybind:
    chord: str
    desc: str
    dispatcher: str
    arg: str
    mouse: bool
    sorting_priority: int

    @property
    def display_line(self) -> str:
        """Format the key chord and description into a monospace-aligned row."""
        # 27 chars provides exact vertical column alignment for monospace fonts
        return f"{self.chord:<27} →  {self.desc}"


def get_chord(modmask: int, key: str) -> str:
    """Decode a modifier bitmask and key into a readable chord string.

    Args:
        modmask: Integer bitmask of active modifier keys (e.g. 64 for
            SUPER).
        key: Raw key identifier from Hyprland (e.g. 'Return', 'XF86AudioMute').

    Returns:
        Formatted key combination string (e.g. 'SUPER + SHIFT + Enter').
    """
    mods = []
    if modmask & 64:
        mods.append("SUPER")
    if modmask & 4:
        mods.append("CTRL")
    if modmask & 8:
        mods.append("ALT")
    if modmask & 1:
        mods.append("SHIFT")
    k = KEY_MAP.get(key, key)
    return " + ".join(mods + [k]) if mods else k


def sorting_priority(desc: str) -> int:
    """Compute a sorting priority for a keybinding description.

    Lower priority numbers appear earlier in the menu list. Categories are
    ordered across a 1-1000 scale:
      1-99: Primary applications & launchers (Terminal, Browser, Files, Menu)
      100-199: System tools (Keybindings cheatsheet, Lock screen, Color picker,
          Screenshot, Clipboard)
      200-299: Window management & state controls (Close, Float, Fullscreen,
          Maximize, Splits)
      300-399: Window navigation, swapping & dragging (Focus, Directional move,
          Swap, Drag move/resize)
      400-499: UI & aesthetics toggles (Borders/gaps, Waybar, Nightlight, Zoom)
      500-699: Workspaces & special workspaces (200-slot section: Workspace
          switching 500-599. Move to workspace, silent moves & scratchpad
          600-699)
      700-799: Window grouping (Toggle group, Move in/out, Navigation,
          Switch group window 1-10)
      800-899: General unclassified keybinds (fallback: 800)
      900-999: Hardware keys (Volume, Brightness, Media playback)

    Args:
        desc: Descriptive text of the keybinding action.

    Returns:
        Integer priority value used for sorting.
    """
    patterns: list[tuple[str, int]] = [
        # 1-99: Primary applications & launchers
        (r"(?i)Terminal", 10),
        (r"(?i)Browser", 20),
        (r"(?i)File manager", 30),
        (r"(?i)Application menu", 40),
        (r"(?i)System menu", 50),
        # 100-199: System tools & utilities
        (r"(?i)keybinding", 110),
        (r"(?i)Lock screen", 120),
        (r"(?i)Color picker", 130),
        (r"(?i)Screenshot", 140),
        (r"(?i)Clipboard", 150),
        # 200-299: Window management & state controls
        (r"(?i)Close active window", 210),
        (r"(?i)Toggle floating|Pop out", 220),
        (r"(?i)full\s*screen|maximize", 230),
        (r"(?i)split|pseudo", 240),
        # 300-399: Window navigation, swapping & dragging
        (r"(?i)Focus (next|previous)", 310),
        (r"(?i)Move focus", 320),
        (r"(?i)Swap window", 330),
        (r"(?i)^(Move|Resize) window$", 340),
        # 400-499: UI & aesthetic toggles
        (r"(?i)borders|Waybar|night", 410),
        (r"(?i)zoom", 420),
    ]
    # 500-699: Workspaces & special workspaces (200-slot range)
    # 500-599: Workspace navigation & switching
    patterns.extend([
        (r"(?i)Next workspace", 501),
        (r"(?i)Previous workspace", 502),
        (r"(?i)Former workspace", 503),
    ])
    for i in range(1, 11):
        patterns.append((rf"^Workspace {i}$", 510 + i))
    # 600-699: Move to workspace & scratchpad
    for i in range(1, 11):
        patterns.append((rf"^Move to workspace {i}$", 610 + i))
    for i in range(1, 11):
        patterns.append((rf"^Move silently to workspace {i}$", 630 + i))
    patterns.extend([
        (r"(?i)scratchpad", 650),
        (r"(?i)workspace", 690),
        # 700-799: Window grouping
        (r"(?i)Toggle window grouping", 710),
        (r"(?i)Move active window out of group", 720),
        (r"(?i)Move window to group", 730),
        (r"(?i)(Next|Previous) window in group", 740),
        (r"(?i)Move window in group", 750),
    ])
    for i in range(1, 11):
        patterns.append((rf"^Switch to group window {i}$", 760 + i))
    patterns.extend([
        # 900-999: Hardware keys
        (r"(?i)Volume|Mute", 910),
        (r"(?i)Brightness", 920),
        (r"(?i)track|Play|Pause", 930),
    ])
    for pattern, priority in patterns:
        if re.search(pattern, desc):
            return priority
    # Fallback for unclassified keybindings: places them after configured
    # categories but before hardware-specific keys.
    return 800


def load_keybinds() -> list[Keybind]:
    """Load bindings via Hyprland IPC.

    Queries `hyprctl binds -j` for all registered keybindings, filters out
    secondary helper dispatchers (such as `bringactivetotop` which mirrors
    `cyclenext`), deduplicates entries with identical chords and descriptions,
    and returns the list sorted by category priority and key chord.

    Returns:
        List of unique, prioritized Keybind objects.
    """
    try:
        raw = json.loads(subprocess.check_output(["hyprctl", "binds", "-j"]))
    except Exception as e:
        print(f"Error querying hyprctl binds: {e}", file=sys.stderr)
        return []

    items: list[Keybind] = []
    seen = set()

    for b in raw:
        disp = b.get("dispatcher", "")
        # Filter out secondary helper dispatchers that duplicate a primary bind
        if disp == "bringactivetotop":
            continue

        chord = get_chord(b.get("modmask", 0), b.get("key", ""))
        desc = b.get("description", "")
        arg = b.get("arg", "")
        if not desc:
            desc = arg if disp == "exec" else f"{disp} {arg}".strip()

        key_id = (chord, desc)
        if key_id in seen:
            continue
        seen.add(key_id)

        items.append(
            Keybind(
                chord=chord,
                desc=desc,
                dispatcher=disp,
                arg=arg,
                mouse=b.get("mouse", False),
                sorting_priority=sorting_priority(desc),
            )
        )

    items.sort(key=lambda x: (x.sorting_priority, x.chord))
    return items


def execute_keybind(bind: Keybind) -> None:
    """Trigger the compositor action corresponding to a selected Keybind.

    Mouse-drag actions (like resizing or moving windows via pointer drag) are
    skipped since they require active cursor motion. For window-targeting
    actions, a short 50ms pause is introduced to ensure Wofi's layer-shell
    surface has cleanly unmapped and Hyprland has refocused the underlying
    window.

    Args:
        bind: The Keybind instance to execute.
    """
    # Mouse-drag actions require physical cursor motion and cannot be triggered
    # via key press
    if bind.mouse:
        return

    # Brief pause (50ms) to allow Wofi's layer-surface to unmap
    # and compositor focus to settle back onto the active client window.
    time.sleep(0.05)

    if bind.dispatcher == "cyclenext":
        cmd = ["hyprctl", "dispatch", "cyclenext"]
        if bind.arg:
            cmd.append(bind.arg)
        subprocess.run(cmd)
        subprocess.run(["hyprctl", "dispatch", "bringactivetotop"])
    else:
        cmd = ["hyprctl", "dispatch", bind.dispatcher]
        if bind.arg:
            cmd.append(bind.arg)
        subprocess.run(cmd)


def main() -> None:
    """Run the keybindings menu or print the cheatsheet to standard output.

    Supports `--print` or `-p` to output the formatted cheatsheet without
    launching Wofi. If launched interactively when Wofi is already running,
    it acts as a toggle and terminates the active Wofi instance. Otherwise,
    it displays the keybindings in Wofi and executes any selected action.
    """
    print_mode = any(arg in sys.argv[1:] for arg in ("--print", "-p"))

    if not print_mode:
        # Toggle behavior: if wofi is already running, close it
        if (
            subprocess.run(
                ["pidof", "wofi"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ).returncode
            == 0
        ):
            subprocess.run(
                ["killall", "wofi"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            sys.exit(0)

    binds = load_keybinds()
    if not binds:
        sys.exit(1)

    if print_mode:
        for b in binds:
            print(b.display_line)
        sys.exit(0)

    binds_by_display = {b.display_line: b for b in binds}
    menu_input = "\n".join(b.display_line for b in binds) + "\n"

    wofi_cmd = ["wofi", "--dmenu"]
    css_path = Path.home() / ".config/wofi/keybinds.css"
    if css_path.exists():
        wofi_cmd.extend(["--style", str(css_path)])

    wofi_cmd.extend([
        "--prompt", "Keybindings",
        "--location", "center",
        "--width", "50%",
        "--insensitive",
        "--no-custom-entry",
    ])

    try:
        result = subprocess.run(
            wofi_cmd,
            input=menu_input,
            # Setting the CWD to the dir with the style sheets is required for
            # relative imports in the CSS files themselves.
            cwd=css_path.parent if css_path.parent.is_dir() else None,
            text=True,
            capture_output=True,
            check=False,
        )
    except Exception as e:
        print(f"Error launching wofi: {e}", file=sys.stderr)
        sys.exit(1)

    if result.returncode != 0:
        # User cancelled (e.g. Esc or clicked outside)
        sys.exit(0)

    selected = result.stdout.strip()
    if not selected:
        sys.exit(0)

    bind = binds_by_display.get(selected)
    if bind:
        execute_keybind(bind)



if __name__ == "__main__":
    main()
