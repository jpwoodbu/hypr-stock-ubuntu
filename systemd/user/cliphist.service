[Unit]
Description=Clipboard text history watcher
Documentation=https://github.com/sentriz/cliphist
PartOf=hyprland-session.target
After=hyprland-session.target

[Service]
Type=simple
# Images are not copied because they  are not displayed in `wofi` menus.
ExecStart=/usr/bin/wl-paste --type text --watch cliphist store
Restart=on-failure
RestartSec=1
Slice=session.slice
