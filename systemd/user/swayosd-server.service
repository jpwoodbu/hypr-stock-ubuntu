[Unit]
Description=SwayOSD on-screen display server
Documentation=https://github.com/ErikReider/SwayOSD
# `swayosd-server` executes volume adjustments and queries current volume
# levels via `libpulse` in response to client requests. It must start after
# `pipewire.service`, `pipewire-pulse.service`, and `wireplumber.service` so
# that the audio routing daemon and hardware endpoints are fully initialized.
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service wireplumber.service
# Ensure the service only starts when a Wayland compositor is active.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/swayosd-server
Restart=on-failure
RestartSec=1
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
